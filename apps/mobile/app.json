{
  "expo": {
    "name": "CardHarbor",
    "slug": "cardharbor",
    "version": "0.2.0",
    "orientation": "portrait",
    "scheme": "cardharbor",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cardharbor.mobile"
    },
    "android": {
      "package": "com.cardharbor.mobile",
      "versionCode": 2,
      "permissions": [
        "CAMERA"
      ]
    },
    "extra": {
      "apiUrl": "http://localhost:8080",
      "eas": {
        "projectId": "8bb913b6-aa7c-49a1-bb3c-b09ed0f56695"
      }
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
